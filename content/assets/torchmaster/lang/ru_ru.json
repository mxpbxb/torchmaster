  "command.torchmaster.torch_list.completed": "\u0421\u043f\u0438\u0441\u043e\u043a \u0444\u0430\u043a\u0435\u043b\u043e\u0432 \u0431\u0443\u0434\u0435\u0442 \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d \u0432 \u0444\u0430\u0439\u043b \u0436\u0443\u0440\u043d\u0430\u043b\u0430",
