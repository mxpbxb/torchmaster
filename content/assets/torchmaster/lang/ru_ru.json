  "text.config.torchmaster-config.option.blockOnlyNaturalSpawns": "\u0411\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0442\u043e\u043b\u044c\u043a\u043e \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435 \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0435",
  "text.config.torchmaster-config.option.blockOnlyNaturalSpawns.tooltip": "\u0415\u0441\u043b\u0438 \u043e\u0442\u043a\u043b\u044e\u0447\u0435\u043d\u043e, \u043c\u0435\u0433\u0430\u0444\u0430\u043a\u0435\u043b \u0438 \u043b\u0430\u043c\u043f\u0430 \u0443\u0436\u0430\u0441\u0430 \u0431\u0443\u0434\u0443\u0442 \u043f\u0440\u0435\u0434\u043e\u0442\u0432\u0440\u0430\u0449\u0430\u0442\u044c \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0435 \u043c\u043e\u0431\u043e\u0432 \u0434\u0430\u0436\u0435 \u0438\u0437 \u0432\u0430\u043d\u0438\u043b\u044c\u043d\u044b\u0445 \u0441\u043f\u0430\u0432\u043d\u0435\u0440\u043e\u0432.",
