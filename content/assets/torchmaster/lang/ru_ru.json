  "block.torchmaster.feral_flare_lantern": "\u0411\u043e\u043b\u044c\u0448\u043e\u0439 \u043e\u0441\u0432\u0435\u0442\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0444\u043e\u043d\u0430\u0440\u044c",
